# ─────────────────────────────────────────────────────────────────────────────
# Hugging Face credentials — required to push datasets and fine-tuned models.
# Locally:  copy this file to .env and fill in.  (.env is gitignored.)
# HF Space: set these as Space Secrets instead — don't upload .env.
# ─────────────────────────────────────────────────────────────────────────────

# Write-scoped token (create at https://huggingface.co/settings/tokens)
HF_TOKEN=hf_your_huggingface_token_here

# Your HF username or org name — model publishes as {HF_USERNAME}/javanese-trocr-handwritten
HF_USERNAME=your_hf_username

# ─────────────────────────────────────────────────────────────────────────────
# TrOCR fine-tuning defaults (training/trocr/finetune_trocr.py)
# These are read by the Space app via env vars; CLI flags override them.
# ─────────────────────────────────────────────────────────────────────────────

# Base model to fine-tune (HuggingFace VisionEncoderDecoderModel checkpoint)
BASE_MODEL=microsoft/trocr-base-handwritten

# Published model name on HF Hub (defaults to {HF_USERNAME}/javanese-trocr-handwritten)
# AUTOTRAIN_PROJECT_NAME is kept for backwards compat but not used by the Seq2SeqTrainer script.
AUTOTRAIN_PROJECT_NAME=javanese-trocr-handwritten

# Optional: HF Hub dataset id — if set, Space loads from Hub instead of local generation
# DATASET_NAME=your_hf_username/javanese-dataset

# Training hyperparameters (Space reads these; CLI flags override)
# EPOCHS=5
# PER_DEVICE_TRAIN_BATCH_SIZE=8
