{
  "name": "aksara-ts",
  "version": "2.1.0",
  "main": "dist/aksara.js",
  "types": "dist/aksara.d.ts",
  "exports": {
    ".": {
      "import": "./dist/aksara.js",
      "require": "./dist/aksara.js",
      "types": "./dist/aksara.d.ts"
    },
    "./segmenter": {
      "import": "./dist/segmenter.js",
      "require": "./dist/segmenter.js",
      "types": "./dist/segmenter.d.ts"
    },
    "./ocr": {
      "import": "./dist/ocr.js",
      "require": "./dist/ocr.js",
      "types": "./dist/ocr.d.ts"
    },
    "./lm": {
      "import": "./dist/lm.js",
      "require": "./dist/lm.js",
      "types": "./dist/lm.d.ts"
    }
  },
  "files": [
    "dist/",
    "model/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "build": "tsc",
    "prepare": "npm run build",
    "train-segmenter": "bun run scripts/train-segmenter.ts",
    "demo": "bun run scripts/demo.ts",
    "ocr-demo": "bun run scripts/ocr-demo.ts",
    "ocr-llm-demo": "bun run scripts/ocr-llm-demo.ts",
    "keyboard": "bun run scripts/keyboard.ts"
  },
  "keywords": [
    "javanese",
    "aksara",
    "hanacaraka",
    "transliteration",
    "typescript"
  ],
  "author": "thesimonharms <simon@simonharms.com>",
  "license": "MIT",
  "description": "A TypeScript library for converting Latin-script Javanese text into Aksara Jawa (Hanacaraka) — bidirectional transliteration, Murda consonants, and neural word segmentation.",
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "onnxruntime-node": "^1.24.3",
    "pngjs": "^7.0.0"
  }
}
